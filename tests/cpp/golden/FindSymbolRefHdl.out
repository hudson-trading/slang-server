module Sub #(
       ^^^ Sym Sub : Definition

    parameter int WIDTH = 16
                  ^^^^^ Sym WIDTH : Parameter

)(

    input logic clk,
                ^^^ Sym clk : Net

    input logic rst,
                ^^^ Sym rst : Net

    input logic [WIDTH-1:0] data_in,
                 ^^^^^ Ref -> **Parameter** `WIDTH` in `Sub`  \n\Type: `int`  \n\\n\\n\---\n\\n\`parameter int WIDTH = 16`
                            ^^^^^^^ Sym data_in : Net

    output logic [WIDTH-1:0] data_out
                  ^^^^^ Ref -> **Parameter** `WIDTH` in `Sub`  \n\Type: `int`  \n\\n\\n\---\n\\n\`parameter int WIDTH = 16`
                             ^^^^^^^^ Sym data_out : Variable

);



    always_ff @(posedge clk or posedge rst) begin
                        ^^^ Ref -> **Input Net** `clk` in `Sub`  \n\Type: `logic`  \n\\n\\n\---\n\\n\`input logic clk`
                                       ^^^ Ref -> **Input Net** `rst` in `Sub`  \n\Type: `logic`  \n\\n\\n\---\n\\n\`input logic rst`

        if (rst) begin
            ^^^ Ref -> **Input Net** `rst` in `Sub`  \n\Type: `logic`  \n\\n\\n\---\n\\n\`input logic rst`

            data_out <= '0;
            ^^^^^^^^ Ref -> **Output Variable** `data_out` in `Sub`  \n\Declared Type: `logic [WIDTH-1:0]`  \n\\n\\n\---\n\\n\`output logic [WIDTH-1:0] data_out`

        end else begin

            data_out <= data_in;
            ^^^^^^^^ Ref -> **Output Variable** `data_out` in `Sub`  \n\Declared Type: `logic [WIDTH-1:0]`  \n\\n\\n\---\n\\n\`output logic [WIDTH-1:0] data_out`
                        ^^^^^^^ Ref -> **Input Net** `data_in` in `Sub`  \n\Declared Type: `logic [WIDTH-1:0]`  \n\\n\\n\---\n\\n\`input logic [WIDTH-1:0] data_in`

        end

    end



endmodule



